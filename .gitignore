.venv/
__pycache__/
*.py[cod]
.pytest_cache/
dist/
build/
*.egg-info/
.playwright-mcp/
gomoku/rapfi/

# 시험 원자료(시험지·정답 PDF, 페이지 이미지, 쪽별 추출 텍스트)는 올리지 않는다.
# 출처 URL과 sha256은 각 폴더의 source-manifest.json, 목록은 csat/SOURCES.md에 있다.
csat/sources/
csat/all_subjects/sources/
csat/all_subjects/images/
csat/exams/*/sources/
csat/exams/*/images/
csat/prompt_study/validation_2025/sources/
csat/prompt_study/validation_2025/images/
csat/prompt_study/input_audit/*.png
**/__pycache__/

# 모델 호출 결과 원자료(작은 JSON 수만 개)는 archives/*.tar.gz로 묶어 올린다. 요약(report.json, scores.json)은 그대로 둔다.
csat/bench/results/*/*/
gamebench/results/*/*/
csat/all_subjects/results/*/
csat/prompt_study/development/*/

# 대국 원자료: 판별 폴더는 통합 JSON의 games와 중복이라 올리지 않는다(이미 커밋된 것은 그대로).
chess/matches/*/
go/matches/*/
# 큰 통합 JSON은 archives/chess-matches-full.tar.gz에 있다.
chess/matches/d2jev-vs-d2-100-noise10.json
chess/matches/d2jevc02-vs-d2-100.json
chess/matches/d2jevc04-vs-d2-100-noise10.json
chess/matches/d2jevc04-vs-d2-100.json
chess/matches/d2jevc04-vs-d2-100b.json
chess/matches/d2plain-noise10-vs-d2plain-100.json
chess/matches/d2plain-noise30-vs-d2plain-100.json
chess/matches/d2plain-vs-d2-100-12ply.json
chess/matches/d2plain-vs-d2-100-noise10.json
chess/matches/d2plain-vs-d2-100-noise30.json
chess/matches/d2plain-vs-d2-100.json
chess/matches/d2plain-vs-d2-100b.json
chess/matches/d2rand-vs-d2-100-noise10.json
chess/matches/d2rand-vs-d2-100b.json
chess/matches/d2sparserand-vs-d2-100-noise10-audit01.json

# Clef 토크나이저 원본 사본(20MB). 같은 revision을 Hugging Face에서 받을 수 있고 sha256은 clef/manifest.json에 있다.
csat/bench/clef/reference/tokenizer.json
# 학습 진단용 생성 데이터. 각 build_data.py가 다시 만들고, sha256은 같은 폴더의 manifest.json에 있다. 평가 세트(test/)는 올린다.
gamebench/tune/data/*.jsonl
gamebench/tune/c4/data*/
gamebench/tune/c4/mem-*/
# 결과 사이트는 자체 git 저장소로 따로 관리한다(scripts/export_metrics.py가 이 저장소의 집계를 읽는다).
result-site/
